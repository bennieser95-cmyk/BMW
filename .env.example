# Canonical application URL for the current environment.
APP_BASE_URL=http://localhost:3000

# Neon pooled runtime connection and direct migration connection.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Branch-specific Neon Auth endpoint and signing secret (minimum 32 characters).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Optional headless CMS configuration.
CMS_API_URL=
CMS_API_TOKEN=

# Webhook and scheduled-job secrets.
REVALIDATE_SECRET=
CRON_SECRET=
# HMAC pseudonymization for durable rate limits and account deletion guards (32+ characters).
RATE_LIMIT_SECRET=

# Optional Sentry project DSN.
SENTRY_DSN=

# Public locale preference. This is the only client-visible setting.
NEXT_PUBLIC_DEFAULT_LOCALE=de-de

{
  "name": "bavaria-digital-showroom",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --config vitest.ci.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --config=playwright.ci.config.ts --grep @smoke",
    "test:e2e:a11y": "playwright test --config=playwright.ci.config.ts --grep @a11y",
    "test:e2e:visual": "playwright test --config=playwright.ci.config.ts --grep @visual",
    "analyze": "ANALYZE=true next build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed.ts",
    "api:generate": "tsx scripts/generate-openapi.ts",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/auth": "0.7.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@vercel/otel": "2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.63.0",
    "next": "^16.0.0",
    "next-intl": "4.14.9",
    "nuqs": "^2.6.0",
    "pino": "10.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@next/bundle-analyzer": "16.4.3",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "4.1.12",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "^4.3.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^27.0.0",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "^10.6.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@better-auth/core": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "better-auth": "1.7.14",
    "zod": "$zod",
    "esbuild": "0.28.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,css}": "prettier --write",
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix --max-warnings 0 --no-warn-ignored"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
